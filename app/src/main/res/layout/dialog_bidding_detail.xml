<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/edittext_bordered"
    android:padding="24dp">

    <ScrollView
        android:id="@+id/dialogScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/dialogRequestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="40dp"
            android:layout_gravity="center_vertical"
            android:textColor="@color/main_netural_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/dialogCloseIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_close_icon"
            android:contentDescription="@string/request_detail_close"
            android:scaleType="centerInside"
            android:padding="6dp"
            app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/light_red_icon" />
    </FrameLayout>


    <TextView
        android:id="@+id/dialogRequestStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/input_border_light_grey" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/request_detail_label_description"
        android:textColor="@color/main_cust_color_legacy"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Description body -->
    <TextView
        android:id="@+id/dialogRequestBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/main_netural_color"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.3" />

    <TextView
        android:id="@+id/dialogShowMoreButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show more"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/main_cust_color_legacy"
        android:layout_marginTop="1dp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/input_border_light_grey" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/request_detail_label_posted"
        android:textColor="@color/main_cust_color_legacy"
        android:textSize="13sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/dialogRequestTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/main_netural_color"
        android:textSize="15sp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/bid_amount_label"
        android:textColor="@color/main_cust_color_legacy"
        android:textSize="13sp"
        android:textStyle="bold" />


    <EditText
        android:id="@+id/dialogBidAmountInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/edittext_bordered"
        android:hint="@string/bid_amount_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColorHint="#666666"
        android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
    <Button
        android:id="@+id/dialogPickTimeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pick a time"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/main_cust_color_legacy"
        android:textColor="@color/main_cust_color_legacy" />

    <TextView
        android:id="@+id/dialogPickedTimeView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:textColor="@color/main_cust_color_legacy"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <Button
        android:id="@+id/dialogBidButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="@string/bid"
        android:textColor="@color/light_blue_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/light_blue"
        app:cornerRadius="10dp" />

</LinearLayout>
