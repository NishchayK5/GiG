                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/input_border_light_grey"
                            app:strokeWidth="1dp">

                            <LinearLayout
