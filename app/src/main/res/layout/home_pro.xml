<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/imgLogobulb"
            android:layout_width="139dp"
            android:layout_height="152dp"
            android:layout_marginTop="10dp"
            app:srcCompat="@drawable/gig_bulb_logo" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/textPageName"
                android:layout_width="272dp"
                android:layout_height="22dp"
                android:textColor="@color/main_pro_color"
                android:gravity="right"
                android:text="@string/home_pro_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/profileInfo"
                android:layout_width="2720dp"
                android:layout_height="22dp"
                android:textColor="@color/main_pro_color"
                android:gravity="right"
                android:text=""
                android:textSize="18sp"
                tools:text="Welcome, Client" />


        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>