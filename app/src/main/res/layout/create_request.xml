<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:minHeight="48dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="16dp"
            android:text="@string/back"
            android:textColor="@color/grey"
            android:textSize="16sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:iconTint="@color/grey" />

        <TextView
            android:id="@+id/createRequestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/create_request_title"
            android:textAlignment="textStart"
            android:textColor="@color/main_netural_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/createRequestSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="15dp"
            android:text="@string/create_request_subtitle"
            android:textAlignment="textStart"
            android:textColor="@color/grey"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/create_request_field_title"
            android:textColor="@color/main_netural_color"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/requestTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_bordered"
            android:hint="@string/create_request_field_title_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="50"
            android:maxWidth="320dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColorHint="#666666"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/requestTitleCharCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/grey"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/create_request_field_description"
            android:textColor="@color/main_netural_color"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/requestDescriptionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_bordered"
            android:gravity="top|start"
            android:hint="@string/create_request_field_description_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxWidth="320dp"
            android:minHeight="120dp"
            android:padding="12dp"
            android:textColorHint="#666666"
            android:textSize="16sp" />

        <Button
            android:id="@+id/submitRequestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:maxWidth="320dp"
            android:text="@string/create_request_submit"
            android:textSize="14sp"
            app:backgroundTint="@color/main_netural_color" />
    </LinearLayout>
</ScrollView>
