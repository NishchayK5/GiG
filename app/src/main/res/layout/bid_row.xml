<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/bidRowName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="4dp"
        android:textColor="@color/main_netural_color"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/bidRowCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/badge_green"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/bidRowAcceptButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:paddingHorizontal="14dp"
        android:text="@string/bid_accept"
        android:textAllCaps="false"
        android:textColor="@color/light_purple_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/light_purple"
        app:cornerRadius="10dp" />

</LinearLayout>