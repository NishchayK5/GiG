<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/input_border_light_grey"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reviewItemTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/main_netural_color"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Great service" />

            <TextView
                android:id="@+id/reviewItemStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/badge_green"
                android:textSize="13sp"
                tools:text="★★★★★" />
        </LinearLayout>

        <TextView
            android:id="@+id/reviewItemReviewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/grey"
            android:textSize="12sp"
            tools:text="Alex Client" />

        <TextView
            android:id="@+id/reviewItemBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/main_netural_color"
            android:textSize="14sp"
            tools:text="Very professional and on time." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
