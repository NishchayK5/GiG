<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/page_margin"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="55dp"
            android:layout_height="72dp"
            app:srcCompat="@drawable/gig_bulb_logo" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="322dp"
            app:srcCompat="@drawable/gig_uni_page" />

        <TextView
            android:id="@+id/homeTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/home_tagline_line1"
            android:textAlignment="center"
            android:textColor="@color/main_netural_color"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeTaglineLine2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/home_tagline_line2"
            android:textAlignment="center"
            android:textColor="@color/grey"
            android:textSize="12sp" />

        <Button
            android:id="@+id/loginPageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:maxWidth="320dp"
            android:text="@string/home_login_button"
            android:textColorLink="@color/main_cust_color"
            android:textSize="14sp"
            app:backgroundTint="@color/main_netural_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/grey" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/home_register_as"
                android:textAlignment="center"
                android:textColor="@color/grey"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/grey" />
        </LinearLayout>

        <Button
            android:id="@+id/clientCreationButton"
            style="@style/Widget.G08.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="320dp"
            android:text="@string/home_client_button"
            android:textColor="@color/main_netural_color"
            android:textSize="14sp" />

        <Button
            android:id="@+id/proCreationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="320dp"
            android:layout_marginVertical="10dp"
            android:text="@string/home_pro_button"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/brown" />




    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>