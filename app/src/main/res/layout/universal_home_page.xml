<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        tools:layout_editor_absoluteX="-31dp"
        tools:layout_editor_absoluteY="0dp">


        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="wrap_content"
            android:layout_height="295dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/gig_logo" />

        <Button
            android:id="@+id/loginPageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:maxWidth="320dp"
            android:text="@string/home_login_button"
            android:textColorLink="@color/main_cust_color"
            android:textSize="14sp"
            app:backgroundTint="@color/main_netural_color" />

        <Button
            android:id="@+id/clientCreationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:maxWidth="320dp"
            android:text="@string/home_client_button"
            android:textColorLink="@color/main_cust_color"
            android:textSize="14sp"
            app:backgroundTint="@color/main_cust_color" />

        <Button
            android:id="@+id/proCreationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:maxWidth="320dp"
            android:text="@string/home_pro_button"
            android:textColorLink="@color/main_cust_color"
            android:textSize="14sp"
            app:backgroundTint="@color/main_pro_color" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>